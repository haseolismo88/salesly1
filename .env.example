OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Mock mode is explicit: never silently falls back after a live API error.
SALESly_MOCK_MODE=true
# 1–120 seconds; browser and server both enforce this limit.
MAX_VIDEO_SECONDS=60
# Optional origin restriction for deployed requests (e.g. https://salesly.vercel.app).
APP_ORIGIN=
